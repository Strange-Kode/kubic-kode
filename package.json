{
  "name": "kubic-kode",
  "version": "1.0.0",
  "description": "2D turn based tilemap game engine and related stuff",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Strange-Kode/kubic-kode.git"
  },
  "main": "index.js",
  "module": "index.js",
  "exports": {
    "import": "./index.js",
    "require": "./index.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:tic-tac-toe && npm run test:lobby",
    "test:tic-tac-toe": "node test/tic-tac-toe-game-test.js",
    "test:lobby": "node test/lobby-system-test.js",
    "test:all": "npm run test:tic-tac-toe && npm run test:lobby",
    "start-server": "node game-server/game-server.js",
    "dev-server": "DEBUG_MODE=true DEBUG_LEVEL=trace nodemon game-server/game-server.js",
    "dev-server:debug": "DEBUG_MODE=true DEBUG_LEVEL=info nodemon game-server/game-server.js",
    "dev-server:debug:trace": "DEBUG_MODE=true DEBUG_LEVEL=trace nodemon game-server/game-server.js",
    "dev-server:debug:error": "DEBUG_MODE=true DEBUG_LEVEL=error nodemon game-server/game-server.js",
    "start-server:debug": "DEBUG_MODE=true DEBUG_LEVEL=info node game-server/game-server.js"
  },
  "keywords": [],
  "author": "Nils & Joakim Karlsson",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lodash": "^4.17.21",
    "uuid": "^11.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10"
  },
  "type": "module"
}
