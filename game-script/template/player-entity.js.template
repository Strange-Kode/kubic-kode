import { GameEntity } from "../../../game-engine/game-entity/game-entity.js";

class PlayerEntity extends GameEntity {
  constructor(playerId, name, isComputer = false) {
    super(playerId, name, null); // Pass id, name, position to parent
    this.isComputer = isComputer;
    this.pieces = []; // List of game pieces placed by this player
    {{#HAS_PLAYER_SCORE}}
    this.score = 0;
    {{/HAS_PLAYER_SCORE}}
    {{#HAS_PLAYER_RESOURCES}}
    this.resources = {};
    {{/HAS_PLAYER_RESOURCES}}
  }

  createGamePiece() {
    // Create a basic game piece for this player
    const piece = {
      owner: this,
      playerId: this.id,
      playerName: this.name,
      type: "{{GAME_PIECE_TYPE}}",
      {{#HAS_PIECE_VALUE}}
      value: 1,
      {{/HAS_PIECE_VALUE}}
      toJSON: function() {
        return {
          owner: this.playerId,
          playerName: this.playerName,
          type: this.type
          {{#HAS_PIECE_VALUE}}
          , value: this.value
          {{/HAS_PIECE_VALUE}}
        };
      }
    };
    
    this.pieces.push(piece);
    return piece;
  }
  
  getPlayerType() {
    return this.isComputer ? 'computer' : 'human';
  }

  {{#HAS_PLAYER_SCORE}}
  addScore(points) {
    this.score += points;
  }

  getScore() {
    return this.score;
  }
  {{/HAS_PLAYER_SCORE}}

  {{#HAS_PLAYER_RESOURCES}}
  addResource(resourceType, amount) {
    if (!this.resources[resourceType]) {
      this.resources[resourceType] = 0;
    }
    this.resources[resourceType] += amount;
  }

  getResource(resourceType) {
    return this.resources[resourceType] || 0;
  }

  hasResource(resourceType, amount) {
    return this.getResource(resourceType) >= amount;
  }
  {{/HAS_PLAYER_RESOURCES}}

  clearPieces() {
    this.pieces = [];
  }

  toJSON() {
    return {
      id: this.id,
      name: this.name,
      position: this.position,
      playerType: this.getPlayerType(),
      pieces: this.pieces.map(p => p.toJSON())
      {{#HAS_PLAYER_SCORE}}
      , score: this.score
      {{/HAS_PLAYER_SCORE}}
      {{#HAS_PLAYER_RESOURCES}}
      , resources: this.resources
      {{/HAS_PLAYER_RESOURCES}}
    };
  }
}

export default PlayerEntity;