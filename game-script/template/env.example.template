# Copy this file to .env and update the values as needed

# Server Configuration
KUBIC_PORT=3000
KUBIC_NODE_ENV=development

# Game Token Security (REQUIRED - Set this to a secure random string of at least 32 characters)
KUBIC_GAME_TOKEN_SECRET_KEY={{GAME_TOKEN_SECRET_KEY}}

# Game Token Configuration (Optional - defaults shown)
KUBIC_GAME_TOKEN_ALGORITHM=aes-256-gcm
KUBIC_GAME_TOKEN_IV_LENGTH=16
KUBIC_GAME_TOKEN_SALT_LENGTH=64

# Debug and Logging Configuration
KUBIC_DEBUG_MODE=true
KUBIC_DEBUG_LEVEL=info
KUBIC_LOG_LEVEL=info

# Session Configuration
KUBIC_SESSION_TIMEOUT=3600000
KUBIC_MAX_SESSIONS=100

{{#HAS_DATABASE}}
# Database Configuration (if needed)
KUBIC_DB_HOST=localhost
KUBIC_DB_PORT=5432
KUBIC_DB_NAME={{GAME_SHORT_NAME}}_game
KUBIC_DB_USER=gameuser
KUBIC_DB_PASSWORD=gamepassword
{{/HAS_DATABASE}}

{{#HAS_EXTERNAL_API}}
# External API Configuration (if needed)
KUBIC_API_KEY=your_api_key_here
KUBIC_API_URL=https://api.example.com
{{/HAS_EXTERNAL_API}}
