    const tileMap = this._engine.getTileMap();
    const availablePositions = [];
    
    // Find all available positions
    for (let x = 0; x < tileMap.getWidth(); x++) {
      for (let y = 0; y < tileMap.getHeight(); y++) {
        if (tileMap.isValidPosition(x, y) && !tileMap.getTile(x, y).hasEntity()) {
          availablePositions.push({ x, y });
        }
      }
    }
    
    if (availablePositions.length === 0) {
      return null; // No available moves
    }
    
    // Return a random move (replace this with your AI strategy)
    const randomIndex = Math.floor(Math.random() * availablePositions.length);
    const { x, y } = availablePositions[randomIndex];
    
    return { x, y };
  }
