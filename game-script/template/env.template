DB_HOST=localhost
DB_PORT=5432
DB_NAME={{GAME_SHORT_NAME}}_game
DB_USER=gameuser
DB_PASSWORD=gamepassword
{{/HAS_DATABASE}}

{{#HAS_EXTERNAL_API}}
# External API Configuration (if needed)
API_KEY=your_api_key_here
API_URL=https://api.example.com
{{/HAS_EXTERNAL_API}}