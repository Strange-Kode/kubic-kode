# {{GAME_NAME}} Game Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Game Configuration
GAME_NAME={{GAME_NAME}}
{{#IS_MULTIPLAYER}}
MAX_PLAYERS={{MAX_PLAYERS}}
{{/IS_MULTIPLAYER}}
{{^IS_MULTIPLAYER}}
MAX_PLAYERS=1
{{/IS_MULTIPLAYER}}
{{#IS_SCROLLABLE}}
DEFAULT_GRID_WIDTH={{DEFAULT_GRID_WIDTH}}
DEFAULT_GRID_HEIGHT={{DEFAULT_GRID_HEIGHT}}
{{/IS_SCROLLABLE}}
{{^IS_SCROLLABLE}}
