{{/IS_SCROLLABLE}}

# Session Configuration
SESSION_TIMEOUT=3600000
MAX_SESSIONS=100

# Debug Configuration
DEBUG_MODE=true
LOG_LEVEL=info

{{#HAS_DATABASE}}
