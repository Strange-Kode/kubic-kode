# Game Environment Configuration
# ------------------------------
# Server Configuration
KUBIC_PORT=3000
KUBIC_NODE_ENV=development
# Comma-separated list of allowed CORS origins (browser apps that may call the API).
# Leave unset to deny all cross-origin requests.
KUBIC_ALLOWED_ORIGINS=https://yourgame.example.com

# Session Configuration
KUBIC_SESSION_TIMEOUT=3600000
KUBIC_MAX_SESSIONS=1000

# Debug Configuration
KUBIC_DEBUG_MODE=true
KUBIC_LOG_LEVEL=info

# Session Monitor (logs open session count periodically, default: false)
KUBIC_SESSION_MONITOR=false
# KUBIC_SESSION_MONITOR_INTERVAL=60000

# Game Token Configuration
KUBIC_GAME_TOKEN_SECRET_KEY=<your-secure-32-character-key>
KUBIC_GAME_TOKEN_ALGORITHM=aes-256-gcm
KUBIC_GAME_TOKEN_IV_LENGTH=16
KUBIC_GAME_TOKEN_SALT_LENGTH=64

# Database Configuration (if needed)
KUBIC_DB_HOST=localhost
KUBIC_DB_PORT=<DB PORT>
KUBIC_DB_NAME=<DB NAME>
KUBIC_DB_USER=<DB USER>
KUBIC_DB_PASSWORD=<DB PASSWORD>

# External API Configuration (if needed)
KUBIC_API_KEY=<API KEY>
KUBIC_API_URL=<API URL>

# AI Configuration
# Time Delay In Milliseconds Before AI Automatically Votes Yes To Restart
KUBIC_AI_AUTO_VOTE_DELAY=1500
# Allow AI-only sessions to appear in the session browser (default: false)
KUBIC_ALLOW_AI_HOST=false
