# Required: secret that encrypts game tokens. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KUBIC_GAME_TOKEN_SECRET_KEY=

KUBIC_PORT=3000

# Comma-separated list of browser origins allowed to call the API.
# Leave unset to deny all cross-origin requests.
# KUBIC_ALLOWED_ORIGINS=http://localhost:5173,https://yourgame.example.com

# Computer players
# KUBIC_AI_MOVE_DELAY=0
KUBIC_AI_AUTO_VOTE_DELAY=1500
# List sessions with only computer players as joinable
KUBIC_ALLOW_AI_HOST=false

# Log the open session count periodically
KUBIC_SESSION_MONITOR=false
# KUBIC_SESSION_MONITOR_INTERVAL=60000

# Hold a started session whose only human dropped, when every other seat is a
# computer player, instead of ending it; the session ends if they are not back
# within the solo reconnection window (ms). Shell only, see below.
# KUBIC_HOLD_SOLO_SESSIONS=true
# KUBIC_SOLO_RECONNECTION_WINDOW=600000

# KUBIC_DEBUG_MODE, KUBIC_LOG_LEVEL, the KUBIC_HEARTBEAT_* timings,
# KUBIC_RECONNECTION_WINDOW and the solo hold settings are read before this
# file is loaded, so set them in the shell instead, e.g.
#   KUBIC_DEBUG_MODE=true KUBIC_LOG_LEVEL=debug npm run start-server
# All variables: docs/server-reference.md#environment-variables
